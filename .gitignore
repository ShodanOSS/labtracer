# LabTracer .gitignore
# Ignore everything by default, then allow only the app files.
# Personal data (labs, library, exports, agent token) lives in data/ and stays local.
# Check before each commit:  git status --ignored   and   gitleaks detect --source .

/*

!/.gitignore
!/.gitattributes
!/build.mjs
!/README.md
!/LICENSE
!/NOTICE
!/THIRD_PARTY_NOTICES.md
!/SECURITY.md
!/docs/
!/package.json
!/package-lock.json
!/server.py
!/ssh_bridge.py
!/guac.py
!/monitoring.py
!/collector/
!/start.bat
!/start.sh
!/app/
!/src/
!/agent/
!/tests/

# Never commit these, even inside allowed folders
/agent/agent.json
/agent/targets.json
*.local.*
.env
.env.*
*.pem
*.key
*.crt
*.p12
*.pfx
*.tmp
*.map
__pycache__/
*.pyc
.DS_Store
Thumbs.db
